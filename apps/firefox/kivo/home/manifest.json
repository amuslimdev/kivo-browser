{
  "manifest_version": 2,
  "name": "Kivo Home",
  "description": "Kivo start page, widgets, and Make it yours.",
  "version": "1.0.0",

  "browser_specific_settings": {
    "gecko": {
      "id": "home@kivo"
    }
  },

  "chrome_url_overrides": {
    "newtab": "index.html"
  },

  "chrome_settings_overrides": {
    "homepage": "index.html"
  },

  "experiment_apis": {
    "kivo": {
      "schema": "api.json",
      "parent": {
        "scopes": ["addon_parent"],
        "script": "api.js",
        "paths": [["kivo"]]
      }
    }
  }
}
