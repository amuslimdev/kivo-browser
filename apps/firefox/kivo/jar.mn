# Kivo profiles (G3) on Firefox's profile pages: each Kivo stylesheet imports Firefox's own copy
# (content/browser/kivo/firefox/) and adds to it, and the card covers are Kivo's, in the profile color.
% override chrome://browser/content/profiles/profile-selector.css chrome://browser/content/kivo/profiles/profile-selector.css
% override chrome://browser/content/profiles/profile-card.css chrome://browser/content/kivo/profiles/profile-card.css
% override chrome://browser/content/profiles/profiles-pages.css chrome://browser/content/kivo/profiles/profiles-pages.css
% override chrome://browser/content/profiles/assets/profilesBackground0.svg chrome://browser/content/kivo/profiles/cover0.svg
% override chrome://browser/content/profiles/assets/profilesBackground1.svg chrome://browser/content/kivo/profiles/cover1.svg
% override chrome://browser/content/profiles/assets/profilesBackground2.svg chrome://browser/content/kivo/profiles/cover2.svg
% override chrome://browser/content/profiles/assets/profilesBackground3.svg chrome://browser/content/kivo/profiles/cover3.svg
% override chrome://browser/content/profiles/assets/profilesBackground4.svg chrome://browser/content/kivo/profiles/cover4.svg
% override chrome://browser/content/profiles/assets/plus.svg chrome://browser/content/kivo/profiles/plus.svg

# The private window page in Kivo's night look (private/), on top of Firefox's own copy.
% override chrome://browser/skin/privatebrowsing/aboutPrivateBrowsing.css chrome://browser/content/kivo/private/aboutPrivateBrowsing.css

# about:logins without the Mozilla account and Sync steps (Kivo has no Mozilla account).
