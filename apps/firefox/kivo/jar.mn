# Kivo look (G1): chrome://browser/content/kivo/
# Kivo Home (G2): a built-in extension. Anything under builtin-addons/<dir>/ with a manifest.json is
# listed in built_in_addons.json and installed at startup, like Firefox's own newtab.
# ui/ is the web/ui build and fonts.css is made from web/ui/src/theme.css (tools/sync.ps1).
# Kivo profiles (G3): profiles/ restyles Firefox's profile pages; see the overrides at the end.
# Kivo workspaces (G4): workspaces.css, imported by kivo.css, and the button icon.
# Kivo profile button (G3): profile-menu.css, imported by kivo.css.
browser.jar:
    content/browser/kivo/kivo.css (kivo.css)
    content/browser/kivo/fonts.css (fonts.css)
    content/browser/kivo/workspaces.css (workspaces.css)
    content/browser/kivo/workspaces.svg (workspaces.svg)
    content/browser/kivo/profile-menu.css (profile-menu.css)
    content/browser/kivo/pages.css (pages.css)
    content/browser/kivo/profiles/ (profiles/*)
    content/browser/kivo/firefox/profile-selector.css (/browser/components/profiles/content/profile-selector.css)
    content/browser/kivo/firefox/profile-card.css (/browser/components/profiles/content/profile-card.css)
    content/browser/kivo/firefox/profiles-pages.css (/browser/components/profiles/content/profiles-pages.css)
    content/browser/kivo/private/aboutPrivateBrowsing.css (private/aboutPrivateBrowsing.css)
    content/browser/kivo/firefox/aboutPrivateBrowsing.css (/browser/themes/shared/privatebrowsing/aboutPrivateBrowsing.css)
    builtin-addons/kivo-home/manifest.json (home/manifest.json)
    builtin-addons/kivo-home/api.json (home/api.json)
    builtin-addons/kivo-home/api.js (home/api.js)
    builtin-addons/kivo-home/ (ui/**)

# The theme fonts from the Kivo Home files, as chrome:// for pages whose CSP allows only chrome: (fonts.css).
% content kivo-fonts %builtin-addons/kivo-home/fonts/ contentaccessible=yes

# No Firefox fox ("Kit") or Firefox logo anywhere in Kivo: the chrome registry swaps each image, so every
# place that uses it changes at once. tools/fox-scan.mjs checks every fox image in the build against this list
# (run it after a Firefox update).
#
# Kivo's heroes take the fox's place: the five children from the family game, in a light flat cartoon style.
# Each picture is made for its place, or is a general mood for rare places (docs/MASCOT.md lists them all).
# tools/make-mascot.ps1 makes mascot/<picture>[-<shape>].svg for every name below: the picture centered at the
# proportions of the Firefox image it replaces (-tall 0.62, square, -4x3 1.3, -3x2 1.6, -wide 2.2). The pictures and
# their ChatGPT prompts are in docs/art/mascot/heroes. mask.svg and none.svg are drawn by hand.
    content/browser/kivo/mascot/extensions-wide.svg (mascot/extensions-wide.svg)
    content/browser/kivo/mascot/extensions-3x2.svg (mascot/extensions-3x2.svg)
    content/browser/kivo/mascot/extensions-off-4x3.svg (mascot/extensions-off-4x3.svg)
    content/browser/kivo/mascot/themes-4x3.svg (mascot/themes-4x3.svg)
    content/browser/kivo/mascot/themes.svg (mascot/themes.svg)
    content/browser/kivo/mascot/new-profile-3x2.svg (mascot/new-profile-3x2.svg)
    content/browser/kivo/mascot/security-error.svg (mascot/security-error.svg)
    content/browser/kivo/mascot/passwords.svg (mascot/passwords.svg)
    content/browser/kivo/mascot/restart.svg (mascot/restart.svg)
    content/browser/kivo/mascot/concerned-3x2.svg (mascot/concerned-3x2.svg)
    content/browser/kivo/mascot/concerned.svg (mascot/concerned.svg)
    content/browser/kivo/mascot/concerned-4x3.svg (mascot/concerned-4x3.svg)
    content/browser/kivo/mascot/concerned-wide.svg (mascot/concerned-wide.svg)
    content/browser/kivo/mascot/empty-4x3.svg (mascot/empty-4x3.svg)
    content/browser/kivo/mascot/empty-wide.svg (mascot/empty-wide.svg)
    content/browser/kivo/mascot/happy.svg (mascot/happy.svg)
    content/browser/kivo/mascot/happy-4x3.svg (mascot/happy-4x3.svg)
    content/browser/kivo/mascot/safe.svg (mascot/safe.svg)
    content/browser/kivo/mascot/safe-4x3.svg (mascot/safe-4x3.svg)
    content/browser/kivo/mascot/safe-3x2.svg (mascot/safe-3x2.svg)
    content/browser/kivo/mascot/profiles-3x2.svg (mascot/profiles-3x2.svg)
    content/browser/kivo/mascot/ai.svg (mascot/ai.svg)
    content/browser/kivo/mascot/ai-wide.svg (mascot/ai-wide.svg)
    content/browser/kivo/mascot/hello-wide.svg (mascot/hello-wide.svg)
    content/browser/kivo/mascot/hello-4x3.svg (mascot/hello-4x3.svg)
    content/browser/kivo/mascot/hello.svg (mascot/hello.svg)
    content/browser/kivo/mascot/hello-tall.svg (mascot/hello-tall.svg)
    content/browser/kivo/mascot/hello-3x2.svg (mascot/hello-3x2.svg)
    content/browser/kivo/mascot/mask.svg (mascot/mask.svg)
    content/browser/kivo/mascot/none.svg (mascot/none.svg)

# extensions: The Planner choosing among floating options: the Extensions menu and about:addons with no add-ons.
% override chrome://browser/skin/addons/extensions-panel-empty-onboarding.svg chrome://browser/content/kivo/mascot/extensions-wide.svg
% override chrome://mozapps/skin/extensions/kit-addons.svg chrome://browser/content/kivo/mascot/extensions-3x2.svg

# extensions-off: The Quiet Boy with a grey puzzle piece: the Extensions menu when none is on here.
% override chrome://browser/skin/addons/extensions-panel-empty.svg chrome://browser/content/kivo/mascot/extensions-off-4x3.svg

# themes: The Energetic Girl painting: themes in about:addons, the add-ons welcome.
% override chrome://mozapps/skin/extensions/kit-themes.svg chrome://browser/content/kivo/mascot/themes-4x3.svg
% override chrome://activity-stream/content/data/content/assets/br-amo-fox-paint.svg chrome://browser/content/kivo/mascot/themes.svg

# new-profile: The Young Genius as an excited astronaut: the "Create a new profile" menu.
% override chrome://browser/content/profiles/assets/kit-profiles-light.svg chrome://browser/content/kivo/mascot/new-profile-3x2.svg
% override chrome://browser/content/profiles/assets/kit-profiles-dark.svg chrome://browser/content/kivo/mascot/new-profile-3x2.svg

# security-error: The Planner inspecting a cracked padlock: the website security error page.
% override chrome://global/skin/illustrations/security-error.svg chrome://browser/content/kivo/mascot/security-error.svg

# passwords: The Young Genius with a key and a treasure chest: saved passwords.
% override chrome://global/content/megalist/icons/cpm-fox-illustration.svg chrome://browser/content/kivo/mascot/passwords.svg

# restart: The Little One, sleepy with a teddy: about:restartrequired.
